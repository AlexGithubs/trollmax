# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev asset storage (used by LocalFileStore in place of Vercel Blob)
/.dev-assets

# user-downloaded full-length background source videos (processed into modal/assets)
/manual-background-sources

# temp downloads / ffmpeg scratch (never commit)
/.tmp

# typescript
*.tsbuildinfo
next-env.d.ts
